{
	"Field input": {
		"Shortcut": "Ctrl+M",
		"Rich text shortcut": "Ctrl+Alt+X",
		"Next field": "Ctrl+PgDown",
		"Previous field": "Ctrl+PgUp",
		"Default field state": "rich text",
		"Cycle rich text/Markdown": true,
		"Autohide toolbar": true
	},
	"Window input": {
		"Mode": "note",
		"Shortcut": "Ctrl+Alt+M",
		"Shortcut accept": "Ctrl+Return",
		"Shortcut reject": "Shift+Escape",
		"Size mode": "parent",
		"Last geometry": ""
	},
	"Converter": {
		"Markdown format": {
			"bullet": "-",
			"listItemIndent": "tab",
			"listItemIndentLeadOnly": true,
			"tightenLists": true,
			"tightenHeadings": false,
			"ruleRepetition": 10,
			"tightDefinitions": true,
			"fences": true,
			"hardBreak": "spaces"
		},
		"Markdown extensions": {
			"Definition lists": true,
			"Inline media": true,
			"Tables": "extended",
			"Table newline": "¨",
			"Underline": true,
			"Superscript": true,
			"Subscript": true,
			"Strikethrough": "double"
		}
	},
	"CodeMirror": {
		"keymap": [
			{
				"key": "Mod-f",
				"preventDefault": true,
				"run": "openSearchPanel",
				"scope": "editor search-panel"
			},
			{
				"key": "Mod-n",
				"preventDefault": true,
				"run": "findNext",
				"scope": "editor search-panel",
				"shift": "findPrevious"
			},
			{
				"key": "Mod-d",
				"preventDefault": true,
				"run": "selectNextOccurrence"
			},
			{
				"key": "Mod-Shift-l",
				"preventDefault": true,
				"run": "selectSelectionMatches"
			},
			{
				"key": "Mod-g",
				"preventDefault": true,
				"run": "gotoLine"
			},
			{
				"key": "Escape",
				"preventDefault": true,
				"run": "closeSearchPanel",
				"scope": "editor, editor search-panel",
				"stopPropagation": true
			},
			{
				"key": "Mod-Alt-C",
				"preventDefault": true,
				"run": "clozeCurrent"
			},
			{
				"key": "Mod-Shift-c",
				"preventDefault": true,
				"run": "clozeNext"
			},
			{
				"key": "Mod-Shift-u",
				"preventDefault": true,
				"run": "unclozeSelections"
			},
			{
				"key": "Mod-s",
				"run": "sortClozes",
				"preventDefault": true
			},
			{
				"key": "Mod-Shift-s",
				"run": "syncClozes",
				"preventDefault": true
			},
			{
				"key": "Mod-Shift-a",
				"run": "autoCloze",
				"preventDefault": true
			},
			{
				"key": "Mod-Shift-j",
				"preventDefault": true,
				"run": "joinLines"
			},
			{
				"key": "Mod-v",
				"preventDefault": true,
				"run": "pasteMarkdownAppend"
			},
			{
				"key": "Mod-Shift-v",
				"preventDefault": true,
				"run": "pasteMenu"
			},
			{
				"key": "Mod-h",
				"preventDefault": true,
				"run": "help"
			}
		],
		"search": {
			"caseSensitive": false,
			"regexp": true,
			"wholeWord": false
		}
	},
	"General": {
		"Browser sort field": true
	}
}